/* miniprogram/pages/manage/checkPhotos/checkPhotos.wxss */
page {
  width: 750rpx;
  padding: 35rpx 35rpx 160rpx 35rpx;
  box-sizing: border-box;
  background-color: var(--color-bg);
}

image {
  border-radius: var(--radius-md);
  width: 100%;
  height: 600rpx;
  background-color: var(--color-gray-light);
  margin-top: var(--space-2);
}

button {
  width: 47%;
  display: inline-block;
  box-sizing: border-box;
  font-size: var(--text-md);
  border-radius: var(--radius-md);
}

/* 清掉小程序 button 自带的那圈灰边框，避免和圆角打架 */
button::after {
  border: none;
}

button.primary {
  background-color: var(--color-primary);
  color: var(--color-on-primary);
}

button + button {
  margin-left: 6%;
  /* float: right; */
}

button.long {
  margin: var(--space-3) 0 0 0;
  width: 100%;
}

.verify-box {
  box-sizing: border-box;
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  background-color: #FFFFFF;
  box-shadow: var(--shadow-sm);
  border-radius: var(--radius-md);
}

.label {
  font-size: var(--text-sm);
  color: var(--color-gray-max);
  margin: var(--space-1) 0;
}
.label.cat {
  font-size: var(--text-md);
  color: var(--color-black-min);
}
.label.cat text {
  font-weight: 600;
  color: var(--color-primary);
  text-decoration: none;
}
.label.user.shotTime{
  margin-bottom: var(--space-3);
}

#total-count {
  font-size: var(--text-sm);
  font-weight: 400;
  line-height: 1.6;
  color: var(--color-gray-max);
  background-color: #FFFFFF;
  box-shadow: var(--shadow-sm);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-3);
  border-radius: var(--radius-md);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  padding: 16rpx 40rpx env(safe-area-inset-bottom) 40rpx; /*底部iOS小黑边safe-area*/
  border-top: 2rpx solid var(--color-gray-light);
  background-color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
}

.bottom-bar button.primary, .bottom-bar button.long {
  margin-top: 0;
}
