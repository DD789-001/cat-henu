/* miniprogram/pages/manage/checkFeedbacks/checkFeedbacks.wxss */
page {
  width: 750rpx;
  padding: 180rpx 30rpx 150rpx 30rpx;
  box-sizing: border-box;
  background-color: var(--color-bg);
}

button {
  width: 47%;
  display: inline-block;
  box-sizing: border-box;
  font-size: var(--text-md);
  border-radius: var(--radius-md);
}

/* 清掉小程序 button 自带的那圈灰边框，避免和圆角打架 */
button::after {
  border: none;
}

button.primary {
  background-color: var(--color-primary);
  color: var(--color-on-primary);
  margin-top: var(--space-1);
}

button + button {
  margin-left: 5%;
  /* float: right; */
}

button.long {
  margin: 0;
  width: 100%;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  padding: 16rpx 40rpx env(safe-area-inset-bottom) 40rpx; /*底部iOS小黑边safe-area*/
  border-top: 2rpx solid var(--color-gray-light);
  background-color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
}

.bottom-bar button.primary, .bottom-bar button.long {
  margin-top: 0;
}

#tips {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  box-sizing: border-box;
  z-index: 1;
  font-size: var(--text-sm);
  color: var(--color-gray-max);
  box-shadow: var(--shadow-md);
  padding: var(--space-3) var(--space-4);
  background-color: #FFFFFF;
}

#tips text {
  display: block;
  width: 100%;
  text-align: center;
}

.verify-box {
  box-sizing: border-box;
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  box-shadow: var(--shadow-sm);
  border-radius: var(--radius-md);
  background-color: #FFFFFF;
}

.line {
  display: flex;
  align-items: center;
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-black-light);
  margin-bottom: var(--space-3);
}

.line image.icon {
  height: 40rpx;
  width: 40rpx;
  min-width: 40rpx;
  margin-right: var(--space-2);
}

.bubble1, .bubble2 {
  margin-bottom: var(--space-2);
}

.bubble1 .date, .bubble2 .date {
  font-size: var(--text-sm);
  color: var(--color-gray-max);
  text-align: center;
}

.bubble1 .name, .bubble2 .name {
  font-size: var(--text-sm);
  color: var(--color-gray-max);
}

.bubble1 .name {
  text-align: right;
}

.bubble2 .name {
  text-align: left;
}

.bubble1 .floating, .bubble2 .floating {
  width: max-content;
  max-width: 90%;
}

.bubble1 .floating {
  margin: 0 0 0 auto;
}

.bubble2 .floating {
  margin: 0 auto 0 0;
}

.bubble1 .floating::after, .bubble2 .floating::after {
  display: block;
  content: "";
  clear: both;
}

.bubble1 .floating .content, .bubble2 .floating .content {  
  clear: both;
  position: relative;
  border-radius: var(--radius-md);
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-md);
  line-height: 1.5;
}

/* 用户反馈：浅蓝气泡 + 深色正文 */
.bubble1 .floating .content {
  float: right;
  background: var(--color-primary-light);
  color: var(--color-black-light);
}

/* 管理员回复：主色气泡，必须用 on-primary 白字 */
.bubble2 .floating .content {
  float: left;
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.bubble1 .floating .content::before {
  display: block;
  content: "";
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-left: 8rpx solid var(--color-primary-light);
  border-bottom: 8rpx solid transparent;
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateX(100%) translateY(-50%);
}

.bubble2 .floating .content::before {
  display: block;
  content: "";
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-right: 8rpx solid var(--color-primary);
  border-bottom: 8rpx solid transparent;
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateX(-100%) translateY(-50%);
}

.bubble1 .floating .footer, .bubble2 .floating .footer {
  float: left;
  clear: both;
  background-color: var(--color-gray-light);
  color: var(--color-gray-max);
  font-size: var(--text-sm);
  border-radius: var(--radius-sm);
  padding: var(--space-1) var(--space-3);
  margin-top: var(--space-1);
}

.noReplyLabel {
  font-size: var(--text-sm);
  color: var(--color-gray-max);
  text-align: center;
}
