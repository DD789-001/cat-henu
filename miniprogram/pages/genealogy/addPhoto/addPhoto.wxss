/* miniprogram/pages/genealogy/addPhoto/addPhoto.wxss */

page {
  width: 750rpx;
  padding: var(--space-5) var(--space-4) 0 var(--space-4);
  box-sizing: border-box;
  background-color: var(--color-bg);
}

/* ---------------- 用户信息 ---------------- */
.userInfo {
  width: 100%;
  padding: 0 0 var(--space-1) 0;
  display: flex;
  align-items: center;
}

.userInfo image {
  height: 50rpx;
  width: 50rpx;
  margin-right: var(--space-1);
  border-radius: var(--radius-sm);
}

.userInfo text {
  height: 50rpx;
  line-height: 50rpx;
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-black-light);
}

/* ---------------- 收录通知勾选框 ---------------- */
.need-notice {
  width: 100%;
  padding: 0 0 var(--space-4) 0;
  display: flex;
  align-items: center;
}

.need-notice .my-checkbox {
  width: 40rpx;
  height: 40rpx;
  /* 勾选框需要可辨识的描边，故保留稍深的灰；其余边框统一用极淡的 --color-gray-light */
  border: 2rpx solid var(--color-gray-dark);
  border-radius: 20%;
  padding: 5rpx;
  display: inline-block;
  box-sizing: border-box;
}

.need-notice .my-checkbox .my-checkbox-core {
  width: 100%;
  height: 100%;
  border-radius: 20%;
  background-color: var(--color-gray-light);
}

.need-notice .my-checkbox.checked .my-checkbox-core {
  background-color: var(--color-primary);
  color: var(--color-on-primary);
}

.need-notice text {
  margin-left: var(--space-1);
  height: 100%;
  line-height: 100%;
  font-size: var(--text-md);
  color: var(--color-black-min);
}

/* ---------------- 照片卡片 ---------------- */
.card {
  background-color: #ffffff;
  box-shadow: var(--shadow-sm);
  padding: var(--space-4) var(--space-4) var(--space-2) var(--space-4);
  margin: var(--space-4) 0;
  border-radius: var(--radius-md);
}

.selected-image {
  border-radius: var(--radius-sm);
  width: 630rpx;
  height: 630rpx;
  background-color: var(--color-gray-light);
  margin-bottom: var(--space-4);
}

/* ---------------- 按钮 ---------------- */
button {
  width: 300rpx;
  display: inline-block;
  box-sizing: border-box;
  font-size: var(--text-md);
  line-height: 40rpx;
  padding: var(--space-2) var(--space-4);
  border: 2rpx solid var(--color-gray-light);
  border-radius: var(--radius-md);
  margin-top: var(--space-2);
  background-color: var(--color-white-dark);
  color: var(--color-black-min);
}

button.long {
  /* width: 690rpx; */
  width: 100%;
}

button.primary {
  background-color: var(--color-primary);
  color: var(--color-on-primary);
  border-color: var(--color-primary);
}

button + button {
  margin-left: var(--space-4);
  /* float: right; */
}

/* ---------------- 表单 ---------------- */
.label {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-black-light);
  margin-bottom: var(--space-1);
  margin-left: var(--space-1);
}

picker, input {
  border-bottom: 2rpx solid var(--color-gray-light);
  background-color: var(--color-gray-light);
  border-radius: var(--radius-sm);
  padding: var(--space-2);
  margin-bottom: var(--space-3);
  font-size: var(--text-md);
  color: var(--color-black-light);
}

/* 统一设置相关 */
.set-all {
  background-color: #ffffff;
  box-shadow: var(--shadow-sm);
  padding: var(--space-4) var(--space-4) var(--space-3) var(--space-4);
  margin: var(--space-3) 0;
  border-radius: var(--radius-md);
}

.set-all .title {
  width: 100%;
  text-align: center;
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-black-light);
  margin-bottom: var(--space-2);
}

.tip {
  font-size: var(--text-sm);
  line-height: 1.5;
  color: var(--color-gray-max);
  margin-bottom: var(--space-1);
}
