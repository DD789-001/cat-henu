/* miniprogram/pages/genealogy/genealogy.wxss */

page {
  height: 100%;
  background-color: var(--color-bg);
}

scroll-view {
  -webkit-overflow-scrolling: touch;
  z-index: 0;
  background-color: var(--color-bg);
}

/* ---------------- 猫卡列表 ---------------- */
.cards {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  box-sizing: border-box;
  padding-bottom: var(--space-3);
}

.card {
  width: 690rpx;
  margin-bottom: var(--space-3);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  background-color: #ffffff;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  position: relative;
}

.card view.image {
  height: 560rpx;
  position: relative;
  overflow: hidden;
}

.card view.image .image-title {
  width: 100%;
  height: 48rpx;
  line-height: 48rpx;
  background-color: rgba(0, 0, 0, 0.42);
  text-align: center;
  color: #ffffff;
  font-size: var(--text-xs);
  position: absolute;
  left: 0;
  bottom: 0;
}

.card view.image image {
  width: 100%;
  height: 560rpx;
  background-color: var(--color-gray-light);
  background-image: url(data:image/svg+xml;base64,);
  background-position: center center;
  background-repeat: no-repeat;
  background-size: 40% 40%;
  position: absolute;
}

.card view.image.to_star image {
  filter: grayscale(100%);
}

.card .info {
  padding: var(--space-4);
}

.card .hoverInfo {
  background-color: var(--color-gray-light);
  padding: var(--space-4);
}

.card .info .line {
  display: flex;
  align-items: flex-start;
  margin-bottom: var(--space-2);
  font-size: var(--text-sm);
  line-height: 1.5;
  color: var(--color-black-min);
}

.card .info .line:last-child {
  margin-bottom: 0;
}

.card .info .line.first {
  align-items: center;
  margin-bottom: var(--space-3);
}

.card .info .name {
  font-size: var(--text-lg);
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--color-black-light);
}

.card .info image.gender {
  height: 28rpx;
  width: 28rpx;
  margin-left: 12rpx;
}

/* 状态标签统一为胶囊 */
.card .info .adopt,
.card .info .to_star {
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 14rpx;
  margin-left: 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  text-align: center;
}

.card .info .adopt {
  background-color: var(--color-primary);
  color: var(--color-on-primary);
}

.card .info .to_star {
  background-color: var(--color-gray-light);
  color: var(--color-gray-max);
}

.card .info .popularity {
  margin-left: auto;
  display: flex;
  align-items: center;
  font-size: var(--text-sm);
  color: var(--color-gray-max);
}

.popularity image {
  height: 22rpx;
  width: 40rpx;
  margin-right: 6rpx;
}

.card .line image.icon {
  height: 28rpx;
  width: 28rpx;
  min-width: 28rpx;
  margin-right: var(--space-2);
  margin-top: 2rpx;
}

.card .line .index {
  margin-left: auto;
  font-size: var(--text-xs);
  color: var(--color-gray-dark);
}

.card .line .characteristics,
.card .line .habit {
  flex: 1;
  min-width: 0;
}

/* ---------------- 加载状态 ---------------- */
.loading image {
  width: 166rpx;
  height: 90rpx;
  margin: var(--space-3) auto;
}

.loadnomore image {
  width: 750rpx;
  height: 100rpx;
  margin: var(--space-2) 0;
}

/* ---------------- 新增照片角标 ---------------- */
.card .label {
  position: absolute;
  top: var(--space-3);
  left: 0;
  z-index: 1;
  padding: 8rpx 20rpx;
  font-size: var(--text-xs);
  background-color: var(--color-primary);
  color: var(--color-on-primary);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  box-shadow: var(--shadow-sm);
}

/* ---------------- 广告位 ---------------- */
.card-ad {
  width: 690rpx;
  margin-bottom: var(--space-3);
  border-radius: var(--radius-md);
  background-color: #ffffff;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 200rpx;
  box-sizing: border-box;
}

.card-ad.hidden {
  display: none;
}

/* ---------------- 顶部搜索 ---------------- */
#search {
  width: 750rpx;
  padding: 0 var(--space-3);
  box-sizing: border-box;
  background-color: var(--color-bg);
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

#search.shadow {
  box-shadow: var(--shadow-sm);
}

#search .input-block {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 var(--space-3);
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  background-color: #ffffff;
  border-radius: var(--radius-full);
  box-sizing: border-box;
}

#search .input-icon {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
}

#search .input-icon image {
  width: 100%;
  height: 100%;
}

#search input.name {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  margin-left: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-black-light);
  background-color: transparent;
}

#search .filter-btn {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin-left: var(--space-2);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-radius: var(--radius-full);
}

.filter-btn image {
  width: 36rpx;
  height: 36rpx;
}

.searchPlaceholderStyle {
  color: var(--color-gray-dark);
  font-size: var(--text-sm);
}

/* ---------------- 筛选面板 ---------------- */
#filter-block {
  width: 750rpx;
  position: fixed;
  z-index: 2;
  background-color: rgba(0, 0, 0, .4);
}

#filter-block .filters {
  width: 100%;
  background-color: #ffffff;
  display: flex;
  flex-wrap: nowrap;
}

.f-column {
  height: 460rpx;
  padding: 0 var(--space-2);
  box-sizing: border-box;
}

.f-column .padding-block {
  height: var(--space-2);
}

.f-column-1 {
  width: 34%;
}

.f-column .item {
  display: flex;
  align-items: center;
  margin: var(--space-1) 0;
  padding: 12rpx var(--space-2);
  font-size: var(--text-sm);
  line-height: 40rpx;
  border-radius: var(--radius-full);
  color: var(--color-black-min);
}

.f-column .item.active {
  color: var(--color-primary);
  background-color: var(--color-primary-light);
}

.f-column.main .item.active {
  color: var(--color-on-primary);
  background-color: var(--color-primary);
}

.f-column .item .right-arrow {
  width: 20rpx;
  height: 40rpx;
  margin-left: auto;
  display: flex;
  align-items: center;
}

.right-arrow image {
  height: 20rpx;
  width: 20rpx;
}

#filter-block .divider {
  width: 100%;
  height: 1rpx;
  background-color: var(--color-gray-light);
}

#filter-block .buttons {
  width: 100%;
  display: flex;
  background-color: #ffffff;
  border-top: 2rpx solid var(--color-gray-light);
}

#filter-block .buttons .btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: var(--text-md);
  text-align: center;
  color: var(--color-gray-max);
  background-color: #ffffff;
}

#filter-block .buttons .btn:first-child {
  border-right: 2rpx solid var(--color-gray-light);
}

#filter-block .buttons .active {
  color: var(--color-primary);
  font-weight: 600;
}
