/* miniprogram/pages/info/info.wxss */
page {
  width: 750rpx;
  padding: var(--space-3);
  box-sizing: border-box;
  background-color: var(--color-bg);
}

/* ---------------- 小程序信息 ---------------- */
.mina-info {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  align-items: center;
  padding: var(--space-4) 0 var(--space-2) 0;
}

/* ---------------- 2x2 功能入口网格 ---------------- */
.buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* 入口卡片图自带 330x182 的宽高比，用 calc 让行/列间距都等于 --space-3 */
.buttons .button {
  width: calc((100% - var(--space-3)) / 2);
  height: 182rpx;
  margin-top: var(--space-3);
  background-color: #ffffff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

/* 下面是旧的 */

.mina-info image {
  width: 150rpx;
  height: 150rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.mina-info .title {
  margin-top: var(--space-2);
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-black-light);
}

.mina-info .dev {
  margin-top: var(--space-1);
  font-size: var(--text-sm);
  font-weight: 300;
  color: var(--color-gray-max);
  text-align: center;
}

/* ---------------- 板块标题 ---------------- */
.block-name {
  width: 100%;
  margin-top: var(--space-5);
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-black-light);
  text-align: center;
}

/* ---------------- 友情链接 ---------------- */
.friend-link-box{
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  margin-top: var(--space-2);
  padding: var(--space-3);
  background-color: #ffffff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.friend-link {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 148rpx;
  margin: var(--space-2) 0;
}

.friend-link image {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: var(--space-2);
  border-radius: var(--radius-full);
}

.friend-link-text {
  width: 100%;
  font-size: var(--text-sm);
  color: var(--color-black-min);
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

/* ---------------- 管理后台列表 ---------------- */
.option-box {
  margin-top: var(--space-2);
  padding: 0;
  background-color: #ffffff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.option {
  padding: var(--space-3) var(--space-4);
  position: relative;
  display: flex;
  align-items: center;
}

.option:before {
  content: " ";
  position: absolute;
  left: var(--space-4);
  top: 0;
  right: var(--space-4);
  height: 0;
  border-top: 2rpx solid var(--color-gray-light);
}

.option:first-child:before {
  display: none;
}

.option-text {
  flex: 1;
  font-size: var(--text-md);
  color: var(--color-black-min);
}

.right-arrow image {
  height: 20rpx;
  width: 20rpx;
}
