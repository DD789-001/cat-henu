/* miniprogram/pages/organization/addorgcat/addorgcat.wxss */
@import "../applyorg/applyorg.wxss";

/* 照片墙：三列网格 */
.photos {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-2);
}

.photo {
  width: 200rpx;
  height: 200rpx;
  margin: var(--space-1);
  display: inline-block;
  border-radius: var(--radius-md);
  background-color: var(--color-gray-light);
}

/* “+” 占位块：淡虚线边框，与已有照片区分 */
.addPhoto {
  text-align: center;
  font-size: var(--text-2xl);
  line-height: 200rpx;
  color: var(--color-gray-max);
  background-color: var(--color-gray-light);
  border: 2rpx dashed var(--color-gray-dark);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}
