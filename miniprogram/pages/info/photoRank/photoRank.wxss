/* miniprogram/pages/info/photoRank/photoRank.wxss */
page {
  background-color: var(--color-bg);
}

/* 顶部主色条：深蓝底，文字色必须用 --color-on-primary */
#top-block {
  position: fixed;
  top: 0;
  width: 750rpx;
  height: 100rpx;
  background-color: var(--color-primary);
  color: var(--color-on-primary);
  z-index: -1;
}

.cen-block {
  width: 690rpx;
  height: auto;
  padding: var(--space-4) var(--space-5) var(--space-3) var(--space-5);
  margin: var(--space-3) auto;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);

  display: flex;
  justify-content: space-around;
  align-items: center;
  flex-wrap: wrap;
}

/* 未授权的 */
.unAuth .title {
  width: 100%;
  font-size: var(--text-md);
  color: var(--color-black-min);
  text-align: center;
}
.unAuth .avatar-picker {
  width: 144rpx;
  height: 144rpx;
  padding: 0;
  border: 0;
  border-radius: var(--radius-full);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.unAuth .avatar-picker image {
  width: 144rpx;
  height: 144rpx;
}
.unAuth .nickname-input {
  width: 100%;
  min-height: 80rpx;
  margin: var(--space-2) 0;
  padding: 0 var(--space-3);
  box-sizing: border-box;
  border: 2rpx solid var(--color-gray-light);
  border-radius: var(--radius-sm);
  font-size: var(--text-md);
  color: var(--color-black-light);
}
.my-info image,
.avatar image.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-white-dark);
}


/* 布局 */
.text.cen {
  text-align: center;
}
.text.left{
  width: 20%;
}
.text.right {
  text-align: right;
  width: 20%;
}

/* 文字大小 */
.text .title {
  font-size: var(--text-sm);
  color: var(--color-gray-max);
}
.text .number {
  font-size: var(--text-2xl);
  font-weight: 600;
  color: var(--color-black-light);
}
.text .number.active {
  color: var(--color-primary);
}
.text .name {
  margin-top: var(--space-1);
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-black-light);
}

/* 一行排名 */
.row {
  min-width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: var(--space-2) 0;
}
.row + .row {
  border-top: 2rpx solid var(--color-gray-light);
}
.row .rank {
  width: 80rpx;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-gray-max);
  text-align: left;
}
.row .avatar {
  width: 120rpx;
  height: 120rpx;
  position: relative;
}
.row .avatar image.medal {
  width: 50rpx;
  height: 50rpx;
  position: absolute;
  top: -6rpx;
  left: 0rpx;
}
.row .avatar image.avatar {
  width: 100rpx;
  height: 100rpx;
  position: absolute;
  top: 10rpx;
  left: 10rpx;
}
.row .name {
  padding-left: var(--space-2);
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-black-light);
}
.row .photo_count {
  margin-left: auto;
  font-size: var(--text-2xl);
  font-weight: 600;
  color: var(--color-black-light);
}
.row .photo_count.active {
  color: var(--color-primary);
}

/* 最后的小tip */
.tip {
  margin: var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-gray-max);
}

/* 主色按钮：深蓝底必须配 --color-on-primary 白字 */
button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: var(--space-2) 0;
  padding: 0 var(--space-4);
  box-sizing: border-box;
  font-size: var(--text-md);
  background-color: var(--color-primary);
  color: var(--color-on-primary);
  border: none;
  border-radius: var(--radius-md);
}
button::after {
  border: none;
}

/* 已完善资料时的编辑入口提示 */
.edit-hint {
  font-size: var(--text-xs);
  color: var(--color-gray-max);
  margin-top: var(--space-1);
}

/* 点击头像/昵称的反馈 */
.hover-dim {
  opacity: 0.6;
}

/* 编辑模式下的取消 */
.cancel-edit {
  margin-top: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-gray-max);
  text-align: center;
}
